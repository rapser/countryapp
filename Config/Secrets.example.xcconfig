//
//  Secrets.example.xcconfig
//  CountryApp
//
//  Copia este archivo como `Config/Secrets.xcconfig` (ignorado por git) y completa los valores
//  de Dashboard → Project Settings → API.
//  En xcconfig `//` inicia un comentario: por eso la URL se escribe con `/$()/`.
//

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
